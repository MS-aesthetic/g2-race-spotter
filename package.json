{
  "name": "g2-race-spotter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && prettier --check \"{apps,packages,services,scripts}/**/*.{ts,js,mjs,json}\" \"*.{js,mjs,json,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "check:pins": "node scripts/check-pins.mjs",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:agents:check": "node scripts/sync-agents.mjs --check",
    "sim:scenarios": "node --experimental-strip-types scripts/sim-harness.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
