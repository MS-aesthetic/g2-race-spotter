{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "g2-race-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RaceRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaceRoom"] }],
  "assets": {
    "binding": "ASSETS",
    // `npm run build:site` assembles it: spotter at the root, glasses app
    // under /glasses/. A miss is a plain 404 here; src/index.ts serves the
    // spotter shell for misses outside /glasses/ (T058).
    "directory": "../../site",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "observability": { "enabled": true },
}
