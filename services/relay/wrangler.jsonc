{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "g2-race-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RaceRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaceRoom"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../apps/spotter/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": { "enabled": true },
}
