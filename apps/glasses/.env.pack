# Packaged .ehpk build (`npm run pack -w apps/glasses`): the page runs from inside
# the Even app, not from the relay, so the relay URL is baked in and wins over the
# page origin. `?relay=` still overrides. Bump app.json "version" before each upload.
VITE_RELAY_URL=wss://g2-race-relay.maxx-384.workers.dev
VITE_RELAY_PINNED=1
